{
    "name": "ai-prototype-canvas",
    "type": "module",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build && node scripts/rename-dist.mjs",
        "preview": "vite preview",
        "prepare": "husky",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "e2e": "playwright test"
    },
    "dependencies": {
        "@iconify-json/material-symbols": "^1.2.68",
        "@nuxt/ui": "^4.6.1",
        "@panzoom/panzoom": "^4.6.2",
        "@tanstack/vue-query": "^5.99.2",
        "@vee-validate/zod": "^4.15.1",
        "@vueuse/core": "^14.2.1",
        "ofetch": "^1.5.1",
        "pinia": "^3.0.4",
        "pinia-plugin-persistedstate": "^4.7.1",
        "radash": "^12.1.1",
        "vee-validate": "^4.15.1",
        "vue": "^3.5.32",
        "vue-router": "^5.0.6",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^8.2.0",
        "@playwright/test": "^1.59.1",
        "@types/node": "^24.12.2",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.2.1",
        "husky": "^9.1.7",
        "jsdom": "^29.0.2",
        "lint-staged": "^16.4.0",
        "playwright": "^1.59.1",
        "prettier": "^3.8.3",
        "rimraf": "^6.1.3",
        "sass": "^1.99.0",
        "typescript": "~6.0.2",
        "vite": "^8.0.9",
        "vite-plugin-singlefile": "^2.3.3",
        "vitest": "^4.1.5",
        "vue-tsc": "^3.2.7"
    },
    "lint-staged": {
        "*.{ts,js,vue,json,jsonc}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{scss,md,html}": [
            "prettier --write"
        ]
    }
}
